# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Required for OpenAI Whisper Multilingual Speech Recognition.
# Never expose this on the client. Keep strictly server-side.
OPENAI_API_KEY="sk-..."

# WHISPER_MODEL: OpenAI Whisper model to use for transcription and translation (default: whisper-1)
WHISPER_MODEL="whisper-1"

# WHISPER_API_BASE_URL: Optional custom or self-hosted Whisper endpoint (default: https://api.openai.com/v1)
WHISPER_API_BASE_URL="https://api.openai.com/v1"

# MySQL Database Connection Configuration
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="gram_disha_db"

